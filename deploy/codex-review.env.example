# /etc/codex-review/codex-review.env -- root:codex-review 0640. Holds paths and switches, no secrets.
# CODEX_REVIEW_ACCOUNTS: accounts whose installations and repositories are served; everything else is dropped.
# CODEX_REVIEW_AUTHORS: PR author logins that may trigger a review; a `[bot]` login is accepted only from a GitHub
# App account, any other login only from a user account. Both are required; names compare case-insensitively.
CODEX_REVIEW_APP_ID=
CODEX_REVIEW_PRIVATE_KEY=/etc/codex-review/app-private-key.pem
CODEX_REVIEW_WEBHOOK_SECRET_FILE=/etc/codex-review/webhook-secret
CODEX_REVIEW_ACCOUNTS=qianxueye,InkTrace-Labs
CODEX_REVIEW_AUTHORS=qianxueye,inktrace-coordinator[bot]
CODEX_REVIEW_EXCLUDE_REPOS=
CODEX_REVIEW_INCLUDE_DRAFTS=true
CODEX_REVIEW_LISTEN_PORT=8787
CODEX_REVIEW_MAX_BODY_BYTES=4194304
CODEX_REVIEW_CONCURRENCY=2
CODEX_REVIEW_TIMEOUT_SECONDS=2400
CODEX_REVIEW_MAX_ATTEMPTS=3
# Transient upstream errors (model at capacity, 429, 5xx, network): first delay, delay cap, total retry window.
CODEX_REVIEW_RETRY_FIRST_SECONDS=60
CODEX_REVIEW_RETRY_MAX_DELAY_SECONDS=1800
CODEX_REVIEW_RETRY_WINDOW_SECONDS=7200
CODEX_REVIEW_REDELIVER_HOURS=24
CODEX_REVIEW_STATE_DIR=/var/lib/codex-review
CODEX_REVIEW_CODEX_BIN=/usr/local/bin/codex
CODEX_REVIEW_EFFORT_RULES=/etc/codex-review/effort-rules.json
